# ---- Required ----
# Local Docker Compose database (development-only credentials from docker-compose.yml).
# Hosted providers (Render etc.) give you a "postgres://..." or "postgresql://..." URL; both are accepted.
DATABASE_URL=postgresql+psycopg://newsapp:newsapp_password@localhost:5432/ai_news
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"   (min 32 characters)
JWT_SECRET_KEY=
# Get one at https://gnews.io  (free plan available)
GNEWS_API_KEY=
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Optional (defaults shown) ----
# Model name is configurable; check https://ai.google.dev/gemini-api/docs/models for currently supported names.
GEMINI_MODEL=gemini-2.5-flash
AUTO_SUMMARIZE_LIMIT=2
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated list of allowed browser origins (no trailing slash)
FRONTEND_URL=http://localhost:5173
# GNews language / country filters (country empty = worldwide, e.g. "in", "us")
GNEWS_LANG=en
GNEWS_COUNTRY=
NEWS_PAGE_SIZE=10
NEWS_CACHE_TTL_SECONDS=600
# How many recent chat messages are sent to Gemini on each question
CHAT_HISTORY_WINDOW=10
RATE_LIMIT_ENABLED=true
